# TBH One: environment variables. Names only; never put real values in this file.
# Copy to .env.local for local runs, or set them in Netlify under Site configuration → Environment variables.
# None is required: the site builds and runs without any of them.

# Public address of the live site, used for canonical links, sitemap.xml and structured data.
# Example: https://www.example.org (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# "true" (default) shows the "Demo data" labels; set "false" only once real data is connected.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: turns the "Talk to Us" assistant from approved local answers into the live AI assistant (/api/chat).
# Leave empty to keep the local answers. Keep it secret: set it only in the hosting dashboard.
ANTHROPIC_API_KEY=
# Optional: override the model used by the live assistant (the default is set in src/app/api/chat/route.ts)
ANTHROPIC_MODEL=
